<UserControl x:Class="NETworkManager.Views.NetworkHealthDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:NETworkManager.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModels:NetworkHealthDashboardViewModel}"
             Loaded="NetworkHealthDashboardView_OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Network Health Dashboard" Style="{StaticResource HeaderTextBlock}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Last updated:" Style="{DynamicResource DefaultTextBlock}" Opacity="0.7" />
                        <TextBlock Text="{Binding LastUpdated}" Margin="6,0,0,0" Style="{DynamicResource DefaultTextBlock}" Opacity="0.7" />
                        <TextBlock Text="{Binding StatusMessage}" Margin="12,0,0,0" Foreground="{DynamicResource MahApps.Brushes.Accent}" Style="{DynamicResource DefaultTextBlock}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" />
            </Grid>

            <!-- Status cards -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="NETWORK HEALTH" Style="{DynamicResource DefaultTextBlock}" Opacity="0.7" />
                        <TextBlock Text="{Binding OverallHealth}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" Foreground="{DynamicResource MahApps.Brushes.Accent}" Style="{DynamicResource DefaultTextBlock}" />
                        <TextBlock Text="{Binding MonitoredDeviceCount, StringFormat={}{0} devices}" Margin="0,4,0,0" Style="{DynamicResource DefaultTextBlock}" Opacity="0.8" />
                        <TextBlock Text="{Binding StaleCount, StringFormat=Stale: {0}}" Margin="0,2,0,0" Style="{DynamicResource DefaultTextBlock}" Opacity="0.8" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="MONITORING" Style="{DynamicResource DefaultTextBlock}" Opacity="0.7" />
                        <TextBlock Text="{Binding MonitoringStatus}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" Foreground="{DynamicResource MahApps.Brushes.Accent}" Style="{DynamicResource DefaultTextBlock}" />
                        <TextBlock Text="{Binding MonitoredDeviceCount, StringFormat={}{0} targets}" Margin="0,4,0,0" Style="{DynamicResource DefaultTextBlock}" Opacity="0.8" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="ACTIVE ALERTS" Style="{DynamicResource DefaultTextBlock}" Opacity="0.7" />
                        <TextBlock Text="{Binding ActiveAlertCount}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" Foreground="{DynamicResource MahApps.Brushes.Accent}" Style="{DynamicResource DefaultTextBlock}" />
                        <TextBlock Text="{Binding UnhealthyCount, StringFormat=Unhealthy devices: {0}}" Margin="0,4,0,0" Style="{DynamicResource DefaultTextBlock}" Opacity="0.8" />
                        <TextBlock Text="{Binding DegradedCount, StringFormat=Degraded devices: {0}}" Margin="0,2,0,0" Style="{DynamicResource DefaultTextBlock}" Opacity="0.8" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="INTERFACES" Style="{DynamicResource DefaultTextBlock}" Opacity="0.7" />
                        <TextBlock Text="{Binding InterfaceDown, StringFormat={}{0} DOWN}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" Foreground="{DynamicResource MahApps.Brushes.Accent}" Style="{DynamicResource DefaultTextBlock}" />
                        <TextBlock Text="{Binding InterfaceAdminDown, StringFormat=Admin down: {0}}" Margin="0,4,0,0" Style="{DynamicResource DefaultTextBlock}" Opacity="0.8" />
                        <TextBlock Text="{Binding InterfaceUp, StringFormat=Up: {0}}" Margin="0,2,0,0" Style="{DynamicResource DefaultTextBlock}" Opacity="0.8" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Device health table + filters -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Analyze with AI" Command="{Binding AnalyzeWithAiCommand}" Margin="8,0,0,0" />
                    <TextBox DockPanel.Dock="Right" Width="180" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search device name / id / address" />
                    <ComboBox DockPanel.Dock="Right" Width="110" Margin="0,0,6,0" SelectedItem="{Binding SelectedStatusFilter}"
                              ItemsSource="{Binding StatusFilterOptions}" />
                    <TextBlock Text="Devices" FontWeight="Bold" Style="{DynamicResource DefaultTextBlock}" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" MaxHeight="200">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:DashboardDeviceRow}">
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{DynamicResource DefaultTextBlock}" />
                                <TextBlock Grid.Column="1" Text="{Binding Type}" Style="{DynamicResource DefaultTextBlock}" Opacity="0.8" />
                                <TextBlock Grid.Column="2" Text="{Binding Address}" Style="{DynamicResource DefaultTextBlock}" Opacity="0.8" />
                                <TextBlock Grid.Column="3" Text="{Binding Health}" Foreground="{DynamicResource MahApps.Brushes.Accent}" Style="{DynamicResource DefaultTextBlock}" />
                                <TextBlock Grid.Column="4" Text="{Binding Snmp}" Style="{DynamicResource DefaultTextBlock}" />
                                <TextBlock Grid.Column="5" Text="{Binding Alerts}" Style="{DynamicResource DefaultTextBlock}" />
                                <TextBlock Grid.Column="6" Text="{Binding LastCheck}" Style="{DynamicResource DefaultTextBlock}" Opacity="0.7" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Alerts + events + interface issues -->
            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Active Alerts" FontWeight="Bold" Style="{DynamicResource DefaultTextBlock}" Margin="0,0,0,4" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Alerts}" MaxHeight="180">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:DashboardAlertRow}">
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Style="{DynamicResource DefaultTextBlock}" />
                                    <TextBlock Margin="0,1,0,0" Style="{DynamicResource DefaultTextBlock}" Opacity="0.7">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} · {1} · {2} occurrence(s) · {3}">
                                                <Binding Path="Severity" />
                                                <Binding Path="Target" />
                                                <Binding Path="Occurrences" />
                                                <Binding Path="LastSeen" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Recent Events" FontWeight="Bold" Style="{DynamicResource DefaultTextBlock}" Margin="0,0,0,4" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Events}" MaxHeight="180">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:DashboardEventRow}">
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Style="{DynamicResource DefaultTextBlock}" />
                                    <TextBlock Margin="0,1,0,0" Style="{DynamicResource DefaultTextBlock}" Opacity="0.7">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} · {1} · {2}">
                                                <Binding Path="Time" />
                                                <Binding Path="Target" />
                                                <Binding Path="Kind" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Interface Issues" FontWeight="Bold" Style="{DynamicResource DefaultTextBlock}" Margin="0,0,0,4" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding InterfaceIssues}" MaxHeight="180">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:DashboardIssueRow}">
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding Interface}" Style="{DynamicResource DefaultTextBlock}" />
                                    <TextBlock Text="{Binding Summary}" Margin="0,1,0,0" Style="{DynamicResource DefaultTextBlock}" Opacity="0.7" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- Latency + availability -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Latency (current ping)" FontWeight="Bold" Style="{DynamicResource DefaultTextBlock}" Margin="0,0,0,4" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Latency}" MaxHeight="140">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:DashboardLatencyRow}">
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Target}" Style="{DynamicResource DefaultTextBlock}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Average}" Style="{DynamicResource DefaultTextBlock}" />
                                    <TextBlock Grid.Column="2" Text="{Binding PacketLoss}" Style="{DynamicResource DefaultTextBlock}" Opacity="0.8" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Availability (24h)" FontWeight="Bold" Style="{DynamicResource DefaultTextBlock}" Margin="0,0,0,4" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Availability}" MaxHeight="140">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:DashboardAvailabilityRow}">
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Target}" Style="{DynamicResource DefaultTextBlock}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Availability}" Style="{DynamicResource DefaultTextBlock}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
