<UserControl x:Class="NETworkManager.Views.NetworkMonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:NETworkManager.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModels:NetworkMonitoringViewModel}"
             Loaded="NetworkMonitoringView_OnLoaded"
             Unloaded="NetworkMonitoringView_OnUnloaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Global controls + status -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Network Monitoring" Style="{StaticResource HeaderTextBlock}" />
                <TextBlock Text="Manage monitoring profiles and targets" Style="{DynamicResource DefaultTextBlock}" Opacity="0.7" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Start Monitoring" Command="{Binding StartMonitoringCommand}" Margin="0,0,6,0" />
                <Button Content="Stop Monitoring" Command="{Binding StopMonitoringCommand}" />
            </StackPanel>
        </Grid>

        <!-- Status line -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Monitoring:" Style="{DynamicResource DefaultTextBlock}" FontWeight="Bold" />
            <TextBlock Text="{Binding GlobalStatus}" Margin="6,0,0,0" Foreground="{DynamicResource MahApps.Brushes.Accent}" Style="{DynamicResource DefaultTextBlock}" />
            <TextBlock Text="  ·  " Style="{DynamicResource DefaultTextBlock}" Opacity="0.6" />
            <TextBlock Text="{Binding ActiveTargets, StringFormat=Active: {0}}" Style="{DynamicResource DefaultTextBlock}" />
            <TextBlock Text="  ·  " Style="{DynamicResource DefaultTextBlock}" Opacity="0.6" />
            <TextBlock Text="{Binding HealthyCount, StringFormat=Healthy: {0}}" Style="{DynamicResource DefaultTextBlock}" />
            <TextBlock Text="  ·  " Style="{DynamicResource DefaultTextBlock}" Opacity="0.6" />
            <TextBlock Text="{Binding DegradedCount, StringFormat=Degraded: {0}}" Style="{DynamicResource DefaultTextBlock}" />
            <TextBlock Text="  ·  " Style="{DynamicResource DefaultTextBlock}" Opacity="0.6" />
            <TextBlock Text="{Binding UnhealthyCount, StringFormat=Unhealthy: {0}}" Foreground="{DynamicResource MahApps.Brushes.Accent}" Style="{DynamicResource DefaultTextBlock}" />
        </StackPanel>

        <!-- Profiles (left) + editor (right) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Profiles" FontWeight="Bold" Style="{DynamicResource DefaultTextBlock}" Margin="0,0,0,4" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:MonitoringProfileListItemViewModel}">
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Name}" Style="{DynamicResource DefaultTextBlock}" FontWeight="Bold" />
                                <TextBlock Text="{Binding Enabled, StringFormat=Enabled: {0}}" Style="{DynamicResource DefaultTextBlock}" Opacity="0.7" />
                                <TextBlock Style="{DynamicResource DefaultTextBlock}" Opacity="0.6">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} target(s), {1} check(s)">
                                            <Binding Path="TargetCount" />
                                            <Binding Path="CheckCount" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                    <Button Content="Add" Command="{Binding AddProfileCommand}" Margin="0,0,4,4" />
                    <Button Content="Edit" Command="{Binding EditProfileCommand}" Margin="0,0,4,4" />
                    <Button Content="Delete" Command="{Binding DeleteProfileCommand}" Margin="0,0,4,4" />
                    <Button Content="Enable" Command="{Binding EnableProfileCommand}" Margin="0,0,4,4" />
                    <Button Content="Disable" Command="{Binding DisableProfileCommand}" Margin="0,0,4,4" />
                </WrapPanel>
            </Grid>

            <!-- Editor -->
            <Border Grid.Column="2" BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding EditorTitle}" Style="{DynamicResource DefaultTextBlock}" FontWeight="Bold" Margin="0,0,0,8" />

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Style="{DynamicResource DefaultTextBlock}" Margin="0,0,6,6" />
                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Description:" Style="{DynamicResource DefaultTextBlock}" Margin="0,0,6,6" />
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Enabled:" Style="{DynamicResource DefaultTextBlock}" Margin="0,0,6,6" />
                            <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding ProfileEnabled}" VerticalAlignment="Center" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Interval (s):" Style="{DynamicResource DefaultTextBlock}" Margin="0,0,6,6" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding IntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Timeout (s):" Style="{DynamicResource DefaultTextBlock}" Margin="0,0,6,6" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Max concurrency:" Style="{DynamicResource DefaultTextBlock}" Margin="6,0,6,6" />
                        </Grid>
                        <TextBox Grid.Column="2" Text="{Binding MaxConcurrency, UpdateSourceTrigger=PropertyChanged}" Width="50" VerticalAlignment="Top" />
                    </Grid>

                    <!-- Targets -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="Add Target" Command="{Binding AddTargetCommand}" />
                            <TextBlock Text="Targets" FontWeight="Bold" Style="{DynamicResource DefaultTextBlock}" />
                        </DockPanel>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Targets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:MonitoringTargetItemViewModel}">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" ToolTip="Name" />
                                        <TextBox Grid.Column="1" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" ToolTip="Hostname/IP" />
                                        <ComboBox Grid.Column="2" Margin="0,0,4,0" SelectedItem="{Binding Type, Mode=TwoWay}"
                                                  ItemsSource="{Binding DataContext.TargetTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <TextBox Grid.Column="3" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" ToolTip="Description" />
                                        <CheckBox Grid.Column="4" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Button Grid.Column="5" Content="✕" Command="{Binding DataContext.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Padding="6,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Checks -->
                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="Add Check" Command="{Binding AddCheckCommand}" />
                            <TextBlock Text="Checks" FontWeight="Bold" Style="{DynamicResource DefaultTextBlock}" />
                        </DockPanel>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Checks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:MonitoringCheckItemViewModel}">
                                    <StackPanel Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" Margin="0,0,4,0" SelectedItem="{Binding Type, Mode=TwoWay}"
                                                      ItemsSource="{Binding DataContext.CheckTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <TextBox Grid.Column="1" Text="{Binding TargetId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" ToolTip="Target id" />
                                            <TextBox Grid.Column="2" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" ToolTip="Port (TCP)" />
                                            <TextBox Grid.Column="3" Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" ToolTip="Timeout (s)" />
                                            <TextBox Grid.Column="4" Text="{Binding IntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" ToolTip="Interval (s)" />
                                            <CheckBox Grid.Column="5" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <Button Grid.Column="6" Content="✕" Command="{Binding DataContext.RemoveCheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Padding="6,0" />
                                        </Grid>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" Margin="0,0,4,0" SelectedItem="{Binding SnmpVersion, Mode=TwoWay}"
                                                      ItemsSource="{Binding DataContext.SnmpVersionOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="SNMP version" />
                                            <TextBox Grid.Column="1" Text="{Binding SnmpPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" ToolTip="SNMP port" />
                                            <TextBox Grid.Column="2" Text="{Binding SnmpCredentialReference, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" ToolTip="SNMP credential reference" />
                                            <ComboBox Grid.Column="3" SelectedItem="{Binding SnmpCollectionMode, Mode=TwoWay}"
                                                      ItemsSource="{Binding DataContext.SnmpCollectionModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="SNMP collection mode" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Runtime status -->
                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" MaxHeight="160">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:MonitoringRowViewModel}">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" TextWrapping="Wrap" Style="{DynamicResource DefaultTextBlock}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Health}" Foreground="{DynamicResource MahApps.Brushes.Accent}" Style="{DynamicResource DefaultTextBlock}" />
                                        <TextBlock Grid.Column="2" Text="{Binding LastCheck}" Style="{DynamicResource DefaultTextBlock}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Observed}" TextWrapping="Wrap" Style="{DynamicResource DefaultTextBlock}" Opacity="0.85" />
                                        <TextBlock Grid.Column="4" Text="{Binding LastError}" TextWrapping="Wrap" Style="{DynamicResource DefaultTextBlock}" Opacity="0.7" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Save / Cancel + message -->
                    <Grid Grid.Row="5" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Save" Command="{Binding SaveCommand}" Margin="0,0,6,0" MinWidth="80" />
                        <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" MinWidth="80" />
                        <TextBlock Grid.Column="2" Text="{Binding EditorMessage}" Margin="10,0,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MahApps.Brushes.Accent}" VerticalAlignment="Center"
                                   Style="{DynamicResource DefaultTextBlock}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Alerts -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding AlertCount}" FontWeight="Bold" Style="{DynamicResource DefaultTextBlock}" Margin="0,0,0,4" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <ListBox Grid.Column="0" ItemsSource="{Binding Alerts}" SelectedItem="{Binding SelectedAlert, Mode=TwoWay}" MaxHeight="140">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:AlertRowViewModel}">
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Severity}" Foreground="{DynamicResource MahApps.Brushes.Accent}" Style="{DynamicResource DefaultTextBlock}" />
                                <TextBlock Grid.Column="1" Text="{Binding Target}" Style="{DynamicResource DefaultTextBlock}" />
                                <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{DynamicResource DefaultTextBlock}" Opacity="0.8" />
                                <TextBlock Grid.Column="3" Text="{Binding Title}" TextWrapping="Wrap" Style="{DynamicResource DefaultTextBlock}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Column="2" BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" Padding="8">
                    <StackPanel DataContext="{Binding SelectedAlert}">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" Style="{DynamicResource DefaultTextBlock}" />
                        <TextBlock Text="{Binding Transition}" Margin="0,4,0,0" Style="{DynamicResource DefaultTextBlock}" />
                        <TextBlock Style="{DynamicResource DefaultTextBlock}" Opacity="0.8" Margin="0,4,0,0">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} · {1} · {2} occurrence(s)">
                                    <Binding Path="Severity" />
                                    <Binding Path="Status" />
                                    <Binding Path="Occurrences" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,4,0,0" Style="{DynamicResource DefaultTextBlock}" />
                        <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.8" Style="{DynamicResource DefaultTextBlock}" />
                        <TextBlock Text="{Binding Resolution}" TextWrapping="Wrap" Margin="0,4,0,0" Style="{DynamicResource DefaultTextBlock}" />
                        <Button Content="Acknowledge" Command="{Binding DataContext.AcknowledgeAlertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Margin="0,8,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- History -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding LoadHistoryCommand}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="History" FontWeight="Bold" Style="{DynamicResource DefaultTextBlock}" />
                    <TextBlock Text="{Binding HistoryNote}" Margin="10,0,0,0" Style="{DynamicResource DefaultTextBlock}" Opacity="0.8" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ListBox Grid.Column="0" ItemsSource="{Binding HistoryRows}" MaxHeight="120">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:MonitoringHistoryRowViewModel}">
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Style="{DynamicResource DefaultTextBlock}" />
                                <TextBlock Grid.Column="1" Text="{Binding Target}" Style="{DynamicResource DefaultTextBlock}" />
                                <TextBlock Grid.Column="2" Text="{Binding Check}" Style="{DynamicResource DefaultTextBlock}" />
                                <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{DynamicResource MahApps.Brushes.Accent}" Style="{DynamicResource DefaultTextBlock}" />
                                <TextBlock Grid.Column="4" Text="{Binding Message}" TextWrapping="Wrap" Style="{DynamicResource DefaultTextBlock}" Opacity="0.8" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ListBox Grid.Column="2" ItemsSource="{Binding AlertHistoryRows}" MaxHeight="120">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:AlertHistoryRowViewModel}">
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Created}" Style="{DynamicResource DefaultTextBlock}" />
                                <TextBlock Grid.Column="1" Text="{Binding Target}" Style="{DynamicResource DefaultTextBlock}" />
                                <TextBlock Grid.Column="2" Text="{Binding Severity}" Foreground="{DynamicResource MahApps.Brushes.Accent}" Style="{DynamicResource DefaultTextBlock}" />
                                <TextBlock Grid.Column="3" Text="{Binding Status}" Style="{DynamicResource DefaultTextBlock}" />
                                <TextBlock Grid.Column="4" Text="{Binding Occurrences}" Style="{DynamicResource DefaultTextBlock}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- SNMP Telemetry (Step 13) -->
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="SNMP Telemetry" FontWeight="Bold" Style="{DynamicResource DefaultTextBlock}" Margin="0,0,0,4" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" Padding="8">
                    <StackPanel>
                        <TextBlock Text="SNMP Credential (stored encrypted)" FontWeight="Bold" Style="{DynamicResource DefaultTextBlock}" Margin="0,0,0,4" />
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="Reference" Width="90" Style="{DynamicResource DefaultTextBlock}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding SnmpCredentialReference, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="Version" Width="90" Style="{DynamicResource DefaultTextBlock}" VerticalAlignment="Center" />
                            <ComboBox SelectedItem="{Binding SnmpCredentialVersion, Mode=TwoWay}" ItemsSource="{Binding SnmpVersionOptions}" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="Community" Width="90" Style="{DynamicResource DefaultTextBlock}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding SnmpCommunity, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="Username" Width="90" Style="{DynamicResource DefaultTextBlock}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding SnmpUsername, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="Auth pwd" Width="90" Style="{DynamicResource DefaultTextBlock}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding SnmpAuthPassword, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="Priv pwd" Width="90" Style="{DynamicResource DefaultTextBlock}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding SnmpPrivPassword, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Configure" Command="{Binding ConfigureSnmpCredentialCommand}" Margin="0,0,6,0" />
                            <Button Content="Remove" Command="{Binding RemoveSnmpCredentialCommand}" />
                            <TextBlock Text="{Binding SnmpCredentialStatus}" Margin="10,0,0,0" Foreground="{DynamicResource MahApps.Brushes.Accent}" VerticalAlignment="Center" Style="{DynamicResource DefaultTextBlock}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshSnmpCommand}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Device" Style="{DynamicResource DefaultTextBlock}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding SnmpDeviceTargetId, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="8,0,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding SnmpDeviceSummary}" TextWrapping="Wrap" Style="{DynamicResource DefaultTextBlock}" Margin="0,0,0,4" />
                    <ListBox Grid.Row="2" ItemsSource="{Binding SnmpInterfaces}" MaxHeight="120">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:SnmpInterfaceRowViewModel}">
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Index}" Style="{DynamicResource DefaultTextBlock}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{DynamicResource DefaultTextBlock}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Admin}" Style="{DynamicResource DefaultTextBlock}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Oper}" Foreground="{DynamicResource MahApps.Brushes.Accent}" Style="{DynamicResource DefaultTextBlock}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Speed}" Style="{DynamicResource DefaultTextBlock}" />
                                    <TextBlock Grid.Column="5" Text="{Binding InOctets}" Style="{DynamicResource DefaultTextBlock}" Opacity="0.8" />
                                    <TextBlock Grid.Column="6" Text="{Binding OutOctets}" Style="{DynamicResource DefaultTextBlock}" Opacity="0.8" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>