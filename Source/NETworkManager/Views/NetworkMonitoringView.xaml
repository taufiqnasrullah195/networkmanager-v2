<UserControl x:Class="NETworkManager.Views.NetworkMonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:NETworkManager.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModels:NetworkMonitoringViewModel}"
             Loaded="NetworkMonitoringView_OnLoaded"
             Unloaded="NetworkMonitoringView_OnUnloaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Network Monitoring" Style="{StaticResource HeaderTextBlock}" />
                <TextBlock Text="Read-only health of monitored network targets"
                           Style="{DynamicResource DefaultTextBlock}" Opacity="0.7" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
        </Grid>

        <!-- Column headers -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Target" FontWeight="Bold" Style="{DynamicResource DefaultTextBlock}" />
            <TextBlock Grid.Column="1" Text="Status" FontWeight="Bold" Style="{DynamicResource DefaultTextBlock}" />
            <TextBlock Grid.Column="2" Text="Last Check" FontWeight="Bold" Style="{DynamicResource DefaultTextBlock}" />
            <TextBlock Grid.Column="3" Text="Observed" FontWeight="Bold" Style="{DynamicResource DefaultTextBlock}" />
            <TextBlock Grid.Column="4" Text="Last Error" FontWeight="Bold" Style="{DynamicResource DefaultTextBlock}" />
        </Grid>

        <!-- Rows -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:MonitoringRowViewModel}">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" TextWrapping="Wrap" Style="{DynamicResource DefaultTextBlock}" />
                            <TextBlock Grid.Column="1" Text="{Binding Health}" TextWrapping="Wrap" Foreground="{DynamicResource MahApps.Brushes.Accent}" Style="{DynamicResource DefaultTextBlock}" />
                            <TextBlock Grid.Column="2" Text="{Binding LastCheck}" Style="{DynamicResource DefaultTextBlock}" />
                            <TextBlock Grid.Column="3" Text="{Binding Observed}" TextWrapping="Wrap" Style="{DynamicResource DefaultTextBlock}" Opacity="0.85" />
                            <TextBlock Grid.Column="4" Text="{Binding LastError}" TextWrapping="Wrap" Style="{DynamicResource DefaultTextBlock}" Opacity="0.7" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status / empty state -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,8,0,0"
                   Foreground="{DynamicResource MahApps.Brushes.Accent}"
                   Style="{DynamicResource StatusMessageTextBlock}" />
    </Grid>
</UserControl>