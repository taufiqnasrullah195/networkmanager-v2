<UserControl x:Class="NETworkManager.Views.AICopilotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mahAppsControls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:viewModels="clr-namespace:NETworkManager.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModels:AICopilotViewModel}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="AI Copilot" Style="{StaticResource HeaderTextBlock}" />
            <TextBlock Text="Network troubleshooting and administration assistant"
                       Style="{DynamicResource DefaultTextBlock}" Opacity="0.7" Margin="0,2,0,0" />
            <TextBlock Text="{Binding ProviderInfo}" Foreground="{DynamicResource MahApps.Brushes.Accent}"
                       Style="{DynamicResource StatusMessageTextBlock}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Chat area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="360">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:AICopilotChatEntry}">
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                       Style="{DynamicResource DefaultTextBlock}" />
                            <TextBlock Text="{Binding ToolActivity}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                       Style="{DynamicResource StatusMessageTextBlock}" Margin="0,4,0,0" />
                            <!-- Structured findings (fact / inference / recommendation) -->
                            <ItemsControl ItemsSource="{Binding Findings}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:AIFindingDisplayItem}">
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Type}"
                                                       Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                                       Style="{DynamicResource DefaultTextBlock}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                                                       Style="{DynamicResource DefaultTextBlock}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Structured evidence (from real evidence data, not AI text) -->
                            <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:AIEvidenceDisplayItem}">
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Glyph}" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="0,0,8,0"
                                                       Style="{DynamicResource DefaultTextBlock}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap"
                                                       Style="{DynamicResource DefaultTextBlock}" Opacity="0.7" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Tool activity panel (live) -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                Margin="0,10,0,6" Padding="0,6,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120">
                <ItemsControl ItemsSource="{Binding ToolActivity}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:ToolActivityDisplayItem}">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" Margin="0,0,8,0"
                                           Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                                <TextBlock Grid.Column="1" Text="{Binding ToolName}" Margin="0,0,8,0"
                                           Style="{DynamicResource DefaultTextBlock}" />
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap"
                                           Style="{DynamicResource DefaultTextBlock}" Opacity="0.7" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Input area -->
        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsBusy}"
                     mah:TextBoxHelper.Watermark="Ask a network question..."
                     AcceptsReturn="False" KeyDown="Input_KeyDown" />
            <Button Grid.Column="2" Content="Send" Command="{Binding SendCommand}" MinWidth="80" />
            <Button Grid.Column="4" Content="Cancel" Command="{Binding CancelCommand}" MinWidth="80" />
        </Grid>

        <!-- Status / loading -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <mah:MetroProgressBar Grid.Column="0" Width="60" IsIndeterminate="True"
                                  Foreground="{DynamicResource MahApps.Brushes.Accent}">
                <mah:MetroProgressBar.Style>
                    <Style TargetType="{x:Type mahAppsControls:MetroProgressBar}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </mah:MetroProgressBar.Style>
            </mah:MetroProgressBar>
            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Margin="10,0,0,0"
                       Foreground="{DynamicResource MahApps.Brushes.Accent}"
                       Style="{DynamicResource StatusMessageTextBlock}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>